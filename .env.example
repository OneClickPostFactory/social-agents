NODE_ENV=development
APP_DATA_DIR=./data

# Local/default platform toggles. SaaS production uses per-tenant settings.
ENABLE_THREADS=true
ENABLE_INSTAGRAM=true
ENABLE_LINKEDIN=false
ENABLE_X=false
ENABLE_FACEBOOK=false

# Supabase SaaS worker runtime.
SUPABASE_URL=https://<your-owned-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-or-secret-key>
CREDENTIAL_ENCRYPTION_KEY=<base64-32-byte-key>

# User-installed Reddit Connector. Leave secret empty locally only if you accept
# CREDENTIAL_ENCRYPTION_KEY as the pairing/token hash pepper.
REDDIT_CONNECTOR_ENABLED=true
REDDIT_CONNECTOR_MAX_POSTS_PER_RUN=2
REDDIT_CONNECTOR_PAIRING_TTL_SECONDS=600
REDDIT_CONNECTOR_PAIRING_SECRET=

# OpenAI. In SaaS mode, tenant credentials should be preferred when present.
OPENAI_API_KEY=<local-or-operator-openai-key>
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_MS=90000

# Reddit API client credentials. Tenant author/subreddit filters still come
# from user_sources/settings and must never fall back to these values.
REDDIT_CLIENT_ID=<reddit-script-app-client-id>
REDDIT_CLIENT_SECRET=<reddit-script-app-secret>
REDDIT_PUBLIC_JSON_TRANSPORT=auto
REDDIT_USER_AGENT=oneclickpostfactory-agent/1.0 by u/<operator-reddit-user>

# Durable Instagram media persistence.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
CLOUDINARY_FOLDER=social-agent/instagram

# Meta defaults for local/operator mode only. SaaS uses tenant credentials.
META_GRAPH_VERSION=v25.0
THREADS_GRAPH_VERSION=v1.0
FACEBOOK_USER_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Server-side Threads app secret used only to exchange short-lived user tokens.
THREADS_APP_SECRET=

# LinkedIn local/operator mode only. SaaS tenant values are encrypted in user_credentials.
LINKEDIN_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_EXPIRES_AT=

# X local/operator mode only. SaaS uses tenant credentials.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:4001/auth/x/callback
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Worker controls.
SUPABASE_WORKER_BATCH_SIZE=5
DAILY_INVENTORY_PLANNER_ENABLED=false
DAILY_INVENTORY_PLANNER_START_LOCAL_DATE=
HTTP_TIMEOUT_MS=45000
WORKER_TICK_TOKEN=<optional-manual-tick-token>
